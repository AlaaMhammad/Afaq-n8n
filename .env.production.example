# Production Docker Compose variables — copy to .env on the server (never commit it).
# Laravel's own settings live in backend/.env (template: backend/.env.production.example).
COMPOSE_PROJECT_NAME=afaq

POSTGRES_DB=afaq
POSTGRES_USER=afaq
# Must match DB_PASSWORD in backend/.env. Generate: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Loopback ports the host nginx proxies to (change if already taken on the VPS)
WEB_PORT=8080
FRONTEND_PORT=3000

# Baked into the frontend bundle at build time
NEXT_PUBLIC_API_URL=https://dashboard.afaqn8n.me/api/v1
NEXT_PUBLIC_SITE_URL=https://afaqn8n.me

# Optional: where deploy.sh keeps pre-migration database dumps, and how many to keep
BACKUP_DIR=/var/www/afaq/backups
BACKUP_KEEP=14
