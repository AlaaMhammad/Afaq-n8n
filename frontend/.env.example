# Browser-facing API (also used to build image/CV URLs)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side API base for Server Components. In Docker the frontend container reaches
# Laravel through nginx on the compose network, not through localhost.
API_INTERNAL_URL=http://localhost:8000/api/v1
