APP_NAME="Afaq Automation Agency"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + pgvector (docker-compose service "postgres")
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=afaq
DB_USERNAME=afaq
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=afaq

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@afaqn8n.me"
MAIL_FROM_NAME="${APP_NAME}"

# CORS / Sanctum
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_EXPIRATION=43200

# ── AI (docs/04_features/rag_and_ai_agent.md) ─────────────────────────
# Drivers: gemini | ollama | fake
LLM_DRIVER=gemini
EMBEDDING_DRIVER=gemini

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# text-embedding-004 is retired; gemini-embedding-2 (or gemini-embedding-001) at 768 dims
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Local Ollama (optional): nomic-embed-text is also 768-dim
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── n8n webhook (inquiry notifications) ───────────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── Seeding ───────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@afaqn8n.me
ADMIN_SEED_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
