# Production Laravel settings — copy to backend/.env on the server (never commit it).
# The file is mounted read-only into the backend, queue and scheduler containers.
APP_NAME="Afaq Automation Agency"
APP_ENV=production
# Generate once: docker compose -f docker-compose.prod.yml run --rm --no-deps backend php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://dashboard.afaqn8n.me
FRONTEND_URL=https://afaqn8n.me

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# Logs go to `docker compose logs`
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=afaq
DB_USERNAME=afaq
# Same value as POSTGRES_PASSWORD in the root .env
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=dashboard.afaqn8n.me
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=afaq

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real SMTP (e.g. the mailbox behind info@afaqn8n.me)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@afaqn8n.me"
MAIL_FROM_NAME="${APP_NAME}"

# CORS / Sanctum: the browser calls the API from the frontend origins only
CORS_ALLOWED_ORIGINS=https://afaqn8n.me,https://www.afaqn8n.me
SANCTUM_STATEFUL_DOMAINS=dashboard.afaqn8n.me
SANCTUM_EXPIRATION=43200

# ── AI ────────────────────────────────────────────────────────────────
LLM_DRIVER=gemini
EMBEDDING_DRIVER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# ── n8n webhook (inquiry notifications) ───────────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── First deploy only: seeds the admin (min 12 chars). Remove after `./deploy.sh --seed`. ──
ADMIN_SEED_EMAIL=admin@afaqn8n.me
ADMIN_SEED_PASSWORD=
