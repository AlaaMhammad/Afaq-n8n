# Docker Compose variables (copy to .env). Laravel's own settings live in backend/.env.
COMPOSE_PROJECT_NAME=afaq

POSTGRES_DB=afaq
POSTGRES_USER=afaq
POSTGRES_PASSWORD=secret

# Host ports
POSTGRES_PORT=5432
REDIS_PORT=6379
NGINX_PORT=8000
FRONTEND_PORT=3000

# Frontend (browser-facing URLs)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
